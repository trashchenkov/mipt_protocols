# Скопируйте этот файл в .env рядом с lab.py и заполните ключ.
# Ключ авторизации GigaChat API, НЕ временный access_token.
# Получение: https://developers.sber.ru/studio/workspaces/my-space/get/gigachat-api
# Можно использовать действующий ключ после занятия по RAG.
GIGACHAT_CREDENTIALS=
# Физические лица: PERS; бизнес-пакеты: B2B; бизнес pay-as-you-go: CORP.
# Полные значения: GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель должна быть доступна вашему API-проекту.
GIGACHAT_MODEL=GigaChat-3-Ultra
# False отключает проверку TLS в учебном запуске.
# Для проверки настройте доверенные сертификаты и задайте True; см. README.
GIGACHAT_VERIFY_SSL_CERTS=False
